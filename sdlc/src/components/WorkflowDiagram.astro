---
// Self-contained workflow diagram — no props needed
// Two parallel input paths converge at finalize, then continue to expand and implement
---

<div
  class="workflow-diagram"
  role="img"
  aria-label="SDLC pipeline diagram showing two input paths (conversation and document) that converge at finalization, then continue through expand and implement stages."
>
  <div class="workflow-grid">
    <!-- Top row: conversation path -->
    <div class="path-row top-row">
      <span class="path-label">Conversation path</span>
      <div class="stage-group">
        <div class="stage" title="Format a conversation about a product idea into structured user requirements">draft-user</div>
        <div class="arrow">&rarr;</div>
        <div class="stage" title="Format a conversation about system design into a Product Design Review">draft-pdr</div>
        <div class="arrow">&rarr;</div>
        <div class="stage" title="Format a conversation about phasing and priorities into a release plan">draft-plan</div>
      </div>
    </div>

    <!-- Bottom row: document path (gen-user placeholder + gen-pdr + gen-plan) -->
    <div class="path-row bottom-row">
      <span class="path-label">Document path</span>
      <div class="stage-group">
        <div class="stage placeholder" title="User requirements always come from conversation — there is no gen-user">gen-user</div>
        <div class="arrow">&rarr;</div>
        <div class="stage" title="Generate a PDR directly from a user requirements document (no conversation needed)">gen-pdr</div>
        <div class="arrow">&rarr;</div>
        <div class="stage" title="Generate a release plan directly from a PDR (no conversation needed)">gen-plan</div>
      </div>
    </div>

    <!-- Merge bracket (spans both rows) -->
    <div class="merge-bracket" aria-hidden="true">}</div>

    <!-- Shared path (centered between rows) -->
    <div class="shared-path">
      <div class="stage converge" title="Finalize all three drafts — fill gaps, add traceability, produce executable documents">finalize</div>
      <div class="arrow">&rarr;</div>
      <div class="stage" title="Generate per-phase execution plans with full implementation context">expand</div>
      <div class="arrow">&rarr;</div>
      <div class="stage" title="Execute phases — write code, update task status, commit per phase">implement</div>
    </div>
  </div>
</div>

<style>
  .workflow-diagram {
    margin: 1.5rem 0;
  }

  .workflow-grid {
    display: grid;
    grid-template-columns: 1fr auto auto;
    grid-template-rows: auto auto;
    align-items: center;
    gap: 0;
    width: 100%;
  }

  .path-row {
    padding: 0.4rem 0;
  }

  .path-row.top-row {
    grid-column: 1;
    grid-row: 1;
  }

  .path-row.bottom-row {
    grid-column: 1;
    grid-row: 2;
  }

  .merge-bracket {
    grid-column: 2;
    grid-row: 1 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 0.4rem;
    color: var(--color-accent);
    font-size: 3rem;
    font-weight: 300;
    line-height: 1;
  }

  .shared-path {
    grid-column: 3;
    grid-row: 1 / 3;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .path-label {
    display: block;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    margin-bottom: 0.2rem;
  }

  .stage-group {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .stage {
    background: var(--color-bg);
    border: 2px solid var(--color-accent);
    border-radius: 0.375rem;
    padding: 0.25rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-heading);
    white-space: nowrap;
    cursor: default;
  }

  .stage.placeholder {
    border-style: dashed;
    opacity: 0.5;
  }

  .stage.converge {
    border-color: var(--color-heading);
    background: var(--color-heading);
    color: var(--color-bg);
  }

  .arrow {
    color: var(--color-accent);
    font-size: 1rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .workflow-grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto auto;
      justify-items: center;
      gap: 0.25rem;
    }

    .path-row.top-row {
      grid-column: 1;
      grid-row: 1;
    }

    .path-row.bottom-row {
      grid-column: 1;
      grid-row: 2;
    }

    .merge-bracket {
      grid-column: 1;
      grid-row: 3;
      font-size: 2rem;
      transform: rotate(90deg);
      padding: 0;
    }

    .shared-path {
      grid-column: 1;
      grid-row: 4;
      flex-wrap: wrap;
      justify-content: center;
    }

    .stage-group {
      flex-wrap: wrap;
      justify-content: center;
    }

    .stage {
      font-size: 0.7rem;
      padding: 0.2rem 0.4rem;
    }
  }
</style>
