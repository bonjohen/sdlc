---
const stages = [
  { name: "Idea", desc: "Start with a rough concept", num: "01" },
  { name: "Requirements", desc: "Convert conversation into user requirements", num: "02" },
  { name: "PDR", desc: "Design the physical system", num: "03" },
  { name: "Plan", desc: "Break work into phased releases", num: "04" },
  { name: "Finalize", desc: "Add traceability and implementation detail", num: "05" },
  { name: "Expand", desc: "Generate per-phase execution plans", num: "06" },
  { name: "Implement", desc: "Execute one phase at a time", num: "07" },
];
---

<div
  class="workflow-diagram"
  role="img"
  aria-label="SDLC pipeline diagram showing seven stages from Idea through Implementation, each as a clickable card."
>
  <div class="stage-grid">
    {stages.map((stage, i) => (
      <a href="/workflow/" class="stage-card" title={stage.desc}>
        <span class="stage-num">{stage.num}</span>
        <span class="stage-name">{stage.name}</span>
        <span class="stage-desc">{stage.desc}</span>
        {i < stages.length - 1 && <span class="stage-arrow" aria-hidden="true"></span>}
      </a>
    ))}
  </div>
</div>

<style>
  .workflow-diagram {
    margin: 1.5rem 0;
  }

  .stage-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
    gap: 0.75rem;
  }

  .stage-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-accent-strong);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--color-text);
    box-shadow: var(--shadow-card);
    transition: all 0.2s;
  }

  .stage-card:hover {
    border-top-color: var(--color-accent);
    box-shadow: var(--shadow-card-hover);
    text-decoration: none;
    transform: translateY(-2px);
  }

  .stage-num {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.25rem;
  }

  .stage-name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-heading);
    margin-bottom: 0.25rem;
  }

  .stage-desc {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .stage-arrow {
    display: none;
  }

  @media (max-width: 480px) {
    .stage-grid {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .stage-card {
      flex-direction: row;
      align-items: center;
      gap: 0.75rem;
      padding: 0.75rem;
    }

    .stage-num {
      font-size: 0.65rem;
      margin-bottom: 0;
      min-width: 2rem;
    }

    .stage-name {
      font-size: 0.95rem;
      margin-bottom: 0;
      min-width: 6rem;
    }

    .stage-desc {
      flex: 1;
    }
  }
</style>
