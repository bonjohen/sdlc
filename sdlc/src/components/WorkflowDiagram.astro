---
// Self-contained workflow diagram — no props needed
---

<div
  class="workflow-diagram"
  role="img"
  aria-label="SDLC pipeline diagram showing seven stages: Idea, User Requirements, Product Design Review, Phased Release Plan, Finalized Documents, Phase Execution Plans, and Implementation. Two input paths (conversation and document) converge at finalization."
>
  <div class="workflow-paths">
    <div class="workflow-path conversation-path">
      <span class="path-label">Conversation path</span>
      <div class="stage-group">
        <div class="stage">draft-user</div>
        <div class="arrow">&rarr;</div>
        <div class="stage">draft-pdr</div>
        <div class="arrow">&rarr;</div>
        <div class="stage">draft-plan</div>
      </div>
    </div>
    <div class="workflow-path document-path">
      <span class="path-label">Document path</span>
      <div class="stage-group">
        <div class="stage">gen-pdr</div>
        <div class="arrow">&rarr;</div>
        <div class="stage">gen-plan</div>
      </div>
    </div>
  </div>
  <div class="converge-arrow">&darr;</div>
  <div class="workflow-shared">
    <div class="stage converge">finalize</div>
    <div class="arrow">&rarr;</div>
    <div class="stage">expand</div>
    <div class="arrow">&rarr;</div>
    <div class="stage">implement</div>
  </div>
</div>

<style>
  .workflow-diagram {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.5rem;
    margin: 1.5rem 0;
  }

  .workflow-paths {
    display: flex;
    gap: 2rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .workflow-path {
    text-align: center;
  }

  .path-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .stage-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .stage {
    background: var(--color-bg);
    border: 2px solid var(--color-accent);
    border-radius: 0.375rem;
    padding: 0.4rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-heading);
    white-space: nowrap;
  }

  .stage.converge {
    border-color: var(--color-heading);
    background: var(--color-heading);
    color: var(--color-bg);
  }

  .arrow {
    color: var(--color-accent);
    font-size: 1.25rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .converge-arrow {
    text-align: center;
    color: var(--color-accent);
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0.5rem 0;
  }

  .workflow-shared {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .workflow-paths {
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }

    .stage-group {
      gap: 0.3rem;
    }

    .stage {
      font-size: 0.75rem;
      padding: 0.3rem 0.5rem;
    }
  }
</style>
