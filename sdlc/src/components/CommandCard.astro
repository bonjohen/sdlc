---
interface Props {
  name: string;
  purpose: string;
  input: string;
  output: string;
  path: "conversation" | "document" | "both";
}

const { name, purpose, input, output, path } = Astro.props;
---

<article class="command-card">
  <div class="card-header">
    <h3 class="command-name"><code>{name}</code></h3>
    <span class="path-badge" data-path={path}>{path}</span>
  </div>
  <p class="command-purpose">{purpose}</p>
  <dl class="command-details">
    <dt>Input</dt>
    <dd>{input}</dd>
    <dt>Output</dt>
    <dd>{output}</dd>
  </dl>
  <div class="card-body">
    <slot />
  </div>
</article>

<style>
  .command-card {
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.25rem;
    margin-bottom: 1rem;
    background: var(--color-bg);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .command-name {
    margin: 0;
    font-size: var(--font-size-lg);
  }

  .command-name code {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .path-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.5rem;
    border-radius: 1rem;
    border: 1px solid;
  }

  .path-badge[data-path="conversation"] {
    color: #1a56db;
    border-color: #1a56db;
    background: #eff6ff;
  }

  .path-badge[data-path="document"] {
    color: #166534;
    border-color: #166534;
    background: #f0fdf4;
  }

  .path-badge[data-path="both"] {
    color: #6d28d9;
    border-color: #6d28d9;
    background: #f5f3ff;
  }

  .command-purpose {
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .command-details {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 0.75rem;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  .command-details dt {
    font-weight: 600;
    color: var(--color-heading);
  }

  .command-details dd {
    margin: 0;
    color: var(--color-text);
  }

  .card-body {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--color-text);
  }

  .card-body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
