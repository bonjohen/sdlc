---
interface Props {
  name: string;
  purpose: string;
  input: string;
  output: string;
  path: "conversation" | "document" | "both";
}

const { name, purpose, input, output, path } = Astro.props;
---

<article class="command-card">
  <div class="card-header">
    <h3 class="command-name"><code>{name}</code></h3>
    <span class="path-badge" data-path={path}>{path}</span>
  </div>
  <p class="command-purpose">{purpose}</p>
  <dl class="command-details">
    <dt>Input</dt>
    <dd>{input}</dd>
    <dt>Output</dt>
    <dd>{output}</dd>
  </dl>
  <div class="card-body">
    <slot />
  </div>
</article>

<style>
  .command-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-accent-strong);
    border-radius: var(--radius);
    padding: 1.5rem;
    margin-bottom: 1rem;
    box-shadow: var(--shadow-card);
    transition: box-shadow 0.2s, border-color 0.2s;
  }

  .command-card:hover {
    box-shadow: var(--shadow-card-hover);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .command-name {
    margin: 0;
    font-size: var(--font-size-lg);
  }

  .command-name code {
    background: none;
    padding: 0;
    font-size: inherit;
    color: var(--color-accent);
  }

  .path-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.6rem;
    border-radius: 1rem;
    border: 1px solid;
  }

  .path-badge[data-path="conversation"] {
    color: #93c5fd;
    border-color: #3b82f6;
    background: rgba(59, 130, 246, 0.15);
  }

  .path-badge[data-path="document"] {
    color: #86efac;
    border-color: #22c55e;
    background: rgba(34, 197, 94, 0.15);
  }

  .path-badge[data-path="both"] {
    color: #c4b5fd;
    border-color: #8b5cf6;
    background: rgba(139, 92, 246, 0.15);
  }

  .command-purpose {
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .command-details {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 0.75rem;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  .command-details dt {
    font-weight: 600;
    color: var(--color-heading);
  }

  .command-details dd {
    margin: 0;
    color: var(--color-text-muted);
  }

  .card-body {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--color-text);
  }

  .card-body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
