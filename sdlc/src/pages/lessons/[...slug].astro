---
import { getCollection } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map(lesson => ({
    params: { slug: lesson.id.replace(/\.md$/, '') },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const { Content } = await lesson.render();

const categoryLabels: Record<string, string> = {
  architecture: 'Architecture & Design',
  process: 'Process & Methodology',
  meta: 'Meta',
};
---

<ContentLayout title={lesson.data.title} description={lesson.data.summary}>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/lessons/">Lessons</a>
    <span aria-hidden="true">›</span>
    <span>{categoryLabels[lesson.data.category]}</span>
  </nav>

  <article class="lesson-article">
    <header>
      <span class="category-badge">{categoryLabels[lesson.data.category]}</span>
      <h1>{lesson.data.title}</h1>
      <p class="summary">{lesson.data.summary}</p>
    </header>

    <div class="lesson-content">
      <Content />
    </div>
  </article>

  <nav class="back-link">
    <a href="/lessons/">← All lessons</a>
  </nav>
</ContentLayout>

<style>
  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .breadcrumb a {
    color: var(--color-link);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .breadcrumb span {
    margin: 0 0.5rem;
  }

  .category-badge {
    display: inline-block;
    font-size: 0.8rem;
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius);
    padding: 0.15rem 0.6rem;
    margin-bottom: 0.75rem;
  }

  .lesson-article header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .lesson-article h1 {
    font-size: 2rem;
    color: var(--color-heading);
    margin: 0.5rem 0;
    line-height: 1.2;
  }

  .summary {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin: 0.75rem 0 0;
    line-height: 1.5;
  }

  .lesson-content {
    line-height: 1.7;
  }

  .lesson-content :global(h2) {
    color: var(--color-heading);
    font-size: 1.4rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .lesson-content :global(ul),
  .lesson-content :global(ol) {
    padding-left: 1.5rem;
    margin: 1rem 0;
  }

  .lesson-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .lesson-content :global(strong) {
    color: var(--color-heading);
  }

  .lesson-content :global(code) {
    background: var(--color-bg);
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    font-size: 0.9em;
  }

  .back-link {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .back-link a {
    color: var(--color-link);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .back-link a:hover {
    text-decoration: underline;
  }
</style>
