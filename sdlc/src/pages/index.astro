---
import ContentLayout from '../layouts/ContentLayout.astro';
import WorkflowDiagram from '../components/WorkflowDiagram.astro';
import { siteDescription, siteTitle } from '../config';
---

<ContentLayout title={siteTitle} description={siteDescription}>
  <h1>I2I — From Idea to Implementation</h1>
  <p class="tagline">A prompt-driven SDLC workflow that turns a software idea into implementation-ready plans and working code, through structured document stages.</p>

  <WorkflowDiagram />

  <h2>Explore the Pipeline</h2>
  <div class="cta-grid">
    <a href="/workflow/" class="cta-card">
      <strong>The Workflow</strong>
      <span>See all 8 SDLC commands and the three workflow paths</span>
    </a>
    <a href="/artifacts/" class="cta-card">
      <strong>Example Artifacts</strong>
      <span>Real prompts and generated documents from the pipeline</span>
    </a>
    <a href="/portfolio/" class="cta-card">
      <strong>About This Project</strong>
      <span>What this project demonstrates and who built it</span>
    </a>
  </div>
</ContentLayout>

<style>
  .tagline {
    font-size: var(--font-size-lg);
    color: var(--color-text);
    max-width: 40rem;
    margin-bottom: 2rem;
  }

  .cta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .cta-card {
    display: block;
    padding: 1.25rem;
    border: 2px solid var(--color-border);
    border-radius: 0.5rem;
    text-decoration: none;
    color: var(--color-text);
    transition: border-color 0.15s;
  }

  .cta-card:hover {
    border-color: var(--color-accent);
    color: var(--color-text);
  }

  .cta-card strong {
    display: block;
    font-size: var(--font-size-lg);
    color: var(--color-accent);
    margin-bottom: 0.25rem;
  }

  .cta-card span {
    font-size: 0.9rem;
  }
</style>
